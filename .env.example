# Leave empty for a complete local mock experience.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WHOP_API_KEY=
# Map verified Whop plan IDs by offer and payment type before enabling live checkout.
WHOP_PLAN_IDS_JSON={}
GHL_API_KEY=
GHL_LOCATION_ID=
WHOP_WEBHOOK_SECRET=
# Required to use the internal desk when deploying. Local development needs no password.
DESK_USERNAME=lewis
DESK_PASSWORD=
# Production authentication: Supabase email links. * lets any valid email sign in.
DESK_AUTH_MODE=supabase
DESK_ALLOWED_EMAILS=*
# Defaults to sandbox whenever a Whop key is present. Set false only for production payments.
WHOP_SANDBOX=true
WHOP_COMPANY_ID=

# Public GHL v3 API, location-scoped PIT. Turn writes on only after confirming the account.
GHL_API_VERSION=v3
GHL_WRITES_ENABLED=false
GHL_ADVISORY_CALENDAR_ID=W8BVoDU02Ez8uAbOnGHR
GHL_EMAIL_FROM=
GHL_TEST_CONTACT_IDS_JSON=[]

# Use payment_desk when running setup-isolated.sql in an existing project.
SUPABASE_SCHEMA=public

# Explicit modes. Existing credentials do not enable payments/messages on their own.
WHOP_MODE=mock
GHL_MODE=mock
PAYMENT_AUTOMATION_MODE=mock
# Prefer one existing GHL PaymentWorkflow owning Customer status, Slack, email and access.
PAYMENT_WORKFLOW_OWNER=ghl
GHL_PAYMENT_WORKFLOW_ID=
GHL_PAYMENT_WEBHOOK_URL=
# Local end-to-end tests only. Never enable these on Vercel.
PAYMENT_DESK_LOCAL_TEST=false
WHOP_LOCAL_TEST_PLAN_ID=
# For app-owned orchestration only: a verified workflow that changes native Contact Type.
GHL_CUSTOMER_TYPE_WORKFLOW_ID=
WELCOME_EMAIL_MODE=ghl_workflow
WELCOME_EMAIL_SUBJECT=
WELCOME_EMAIL_HTML=
SLACK_MODE=mock
SLACK_BOT_TOKEN=
SLACK_NEW_CLIENTS_CHANNEL_ID=C0C8ZERCSUT
SLACK_DEPOSITS_CHANNEL_ID=C0C6WTKD468

# Comma-separated GHL user IDs approved as closers. Creator Society defaults to Brooklyn only.
# GHL_CLOSER_USER_IDS=EnYRCrKE1ZwWz9B6T6EY
